/* ---------- 游戏页专属样式 ---------- */
.progress-track {
  height: 6px;
  background: #e4e4e7;
  border-radius: 99px;
  overflow: hidden;
  margin-top: 12px;
}
.progress-bar {
  height: 100%;
  background: #2563eb;
  border-radius: 99px;
  transition: width 0.3s;
}
.progress-low {
  background: #dc2626;
}

.combo {
  text-align: center;
  font-size: 13px;
  font-weight: 700;
  color: #2563eb;
  margin-top: 8px;
  min-height: 20px;
}

.qcard {
  background: #fff;
  border: 1px solid #f4f4f5;
  border-radius: 16px;
  padding: 20px;
  margin-top: 10px;
}
.qtag {
  display: inline-block;
  background: #eff6ff;
  color: #2563eb;
  font-size: 10px;
  font-weight: 700;
  padding: 4px 9px;
  border-radius: 6px;
  align-self: flex-start;
}
.qtext {
  display: block;
  font-size: 17px;
  line-height: 1.65;
  font-weight: 600;
  margin-top: 12px;
}
.qhint {
  display: block;
  font-size: 12px;
  color: rgba(24, 24, 27, 0.55);
  margin-top: 6px;
}

.opts {
  margin-top: 16px;
}
.opt {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fafafa;
  border: 1px solid #e4e4e7;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 10px;
  min-height: 52px;
  box-sizing: border-box;
  transition: background 0.15s, border-color 0.15s;
}
.opt-pressed {
  background: #eff6ff;
  border-color: #2563eb;
}
.opt.correct {
  background: #f0fdf4;
  border-color: #16a34a;
}
.opt.wrong {
  background: #fef2f2;
  border-color: #dc2626;
}
.opt-key {
  width: 26px;
  height: 26px;
  border-radius: 8px;
  background: #e4e4e7;
  color: rgba(24, 24, 27, 0.6);
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.key-correct {
  background: #16a34a !important;
  color: #fff !important;
}
.key-wrong {
  background: #dc2626 !important;
  color: #fff !important;
}
.opt-text {
  font-size: 14px;
  line-height: 1.55;
  flex: 1;
}

.explain {
  margin-top: 16px;
  border-radius: 12px;
  padding: 14px 16px;
  font-size: 13px;
  line-height: 1.6;
}
.explain.ok {
  background: #f0fdf4;
  color: #15803d;
}
.explain.no {
  background: #fef2f2;
  color: #b91c1c;
}
.explain-title {
  display: block;
  font-weight: 700;
}
.explain-answer {
  display: block;
  margin-top: 4px;
  font-weight: 700;
}
.next-btn {
  margin-top: 12px;
  background: #18181b;
  color: #fff;
  border-radius: 10px;
  text-align: center;
  padding: 10px;
  font-size: 13px;
  font-weight: 600;
}
.next-btn-pressed {
  background: #2563eb;
  color: #fff;
}

/* ---------- 结果页 ---------- */
.result {
  text-align: center;
  padding-top: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result-label {
  font-size: 12px;
  color: rgba(24, 24, 27, 0.5);
  letter-spacing: 2px;
}
.score {
  font-size: 72px;
  font-weight: 800;
  color: #2563eb;
  line-height: 1.1;
  margin-top: 8px;
}
.rank-wrap {
  margin-top: 14px;
}
.rank {
  display: inline-block;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 15px;
  font-weight: 700;
  padding: 8px 20px;
  border-radius: 99px;
}
.rgrid {
  display: flex;
  gap: 8px;
  margin-top: 24px;
  width: 100%;
}

.review {
  background: #fff;
  border: 1px solid #f4f4f5;
  border-radius: 16px;
  padding: 16px;
  margin-top: 20px;
  text-align: left;
  width: 100%;
  box-sizing: border-box;
}
.review-title {
  font-size: 14px;
  font-weight: 700;
}
.ritem {
  padding: 10px 0;
  border-top: 1px dashed #e4e4e7;
  font-size: 12px;
  line-height: 1.65;
}
.ritem:first-of-type {
  border-top: none;
}
.rq {
  color: rgba(24, 24, 27, 0.6);
  display: block;
}
.ra {
  color: #16a34a;
  font-weight: 700;
  display: block;
  margin-top: 2px;
}

.primary-btn {
  margin-top: 28px;
  background: #2563eb;
  color: #fff;
  border-radius: 14px;
  text-align: center;
  padding: 13px;
  font-size: 15px;
  font-weight: 700;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
}
.ghost-btn {
  margin-top: 12px;
  background: #fff;
  border: 1px solid #e4e4e7;
  color: rgba(24, 24, 27, 0.7);
  border-radius: 14px;
  text-align: center;
  padding: 13px;
  font-size: 15px;
  font-weight: 600;
  width: 100%;
  box-sizing: border-box;
}
