<!-- 分类专练 -->
<view class="container">
  <text class="section-label">选择一个主题</text>
  <view
    wx:for="{{catList}}"
    wx:key="c"
    class="mode-card"
    hover-class="mode-card-pressed"
    hover-stay-time="80"
    data-cat="{{item.c}}"
    bindtap="onCatTap"
  >
    <view class="cat-row">
      <text class="mode-title">{{item.c}}</text>
      <text class="cat-count">{{item.count}} 题 →</text>
    </view>
  </view>
</view>
