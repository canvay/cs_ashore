/* ---------- 指南列表页专属样式 ---------- */
.page-hero {
  padding: 24px 0 20px;
  display: flex;
  flex-direction: column;
}
.page-hero-title {
  font-size: 22px;
  font-weight: 800;
  line-height: 1.35;
}
.page-hero-sub {
  font-size: 12px;
  color: rgba(24, 24, 27, 0.6);
  margin-top: 8px;
  line-height: 1.7;
}

.article-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: #fff;
  border: 1px solid #f4f4f5;
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 10px;
}
.article-card-pressed {
  transform: scale(0.98);
  background: #fafafa;
}
.article-card-order {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
  font-size: 13px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.article-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.article-card-title {
  font-size: 15px;
  font-weight: 700;
  color: #18181b;
}
.article-card-summary {
  font-size: 12px;
  color: rgba(24, 24, 27, 0.6);
  line-height: 1.7;
  margin-top: 4px;
}
.article-card-meta {
  font-size: 10px;
  color: rgba(24, 24, 27, 0.45);
  margin-top: 8px;
}
.article-card-arrow {
  color: rgba(24, 24, 27, 0.3);
  font-size: 14px;
  margin-top: 2px;
  flex-shrink: 0;
}
