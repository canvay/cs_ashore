/* ---------- 模块首页专属样式 ---------- */
/* 指南入口：白底普通卡（黑话挑战保持蓝色主推样式） */
.portal-entry-plain {
  background: #fff;
  border-color: #f4f4f5;
  margin-bottom: 10px;
}
.portal-entry-tile-plain {
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
}
.portal-entry-plain .portal-entry-arrow {
  color: rgba(24, 24, 27, 0.3);
}
.brand-logo-img {
  width: 52px;
  height: 50px;
  margin-bottom: 14px;
}
.portal-entry {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #eff6ff;
  border: 1px solid rgba(37, 99, 235, 0.25);
  border-radius: 16px;
  padding: 16px;
}
.portal-entry-pressed {
  transform: scale(0.98);
  background: #dbeafe;
}
.portal-entry-tile {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: #2563eb;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 700;
  flex-shrink: 0;
}
.portal-entry-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.portal-entry-title {
  font-size: 16px;
  font-weight: 800;
  color: #18181b;
}
.portal-entry-meta {
  font-size: 11px;
  color: rgba(24, 24, 27, 0.6);
  margin-top: 3px;
}
.portal-entry-arrow {
  color: #2563eb;
  font-size: 16px;
  flex-shrink: 0;
}
