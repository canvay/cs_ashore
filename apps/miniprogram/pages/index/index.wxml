<!-- 模块首页（portal）：返回走原生导航栏 -->
<view class="container">
  <view class="hero">
    <image class="brand-logo-img" src="/images/forashore-icon.png" mode="aspectFit" />
    <text class="hero-title">何以上岸</text>
    <text class="hero-sub">选择一个模块开始，进度保存在本机。</text>
  </view>

  <text class="section-label">模块列表</text>
  <view class="portal-entry" hover-class="portal-entry-pressed" hover-stay-time="80" bindtap="openQuiz">
    <view class="portal-entry-tile">申</view>
    <view class="portal-entry-body">
      <text class="portal-entry-title">黑话挑战</text>
      <text class="portal-entry-meta">{{portal.count}} 题 · 最高 {{portal.best}} 分</text>
    </view>
    <text class="portal-entry-arrow">→</text>
  </view>

  <text class="note">更多模块筹备中，敬请期待</text>
</view>
