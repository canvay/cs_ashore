<!-- 模块首页（portal） -->
<view wx:if="{{view === 'home'}}" class="container">
  <view class="hero">
    <image class="brand-logo-img" src="/images/forashore-icon.png" mode="aspectFit" />
    <text class="hero-title">何以上岸</text>
    <text class="hero-sub">选择一个模块开始，进度保存在本机。</text>
  </view>

  <text class="section-label">模块列表</text>
  <view class="portal-entry" hover-class="portal-entry-pressed" hover-stay-time="80" bindtap="openQuiz">
    <view class="portal-entry-tile">申</view>
    <view class="portal-entry-body">
      <text class="portal-entry-title">黑话挑战</text>
      <text class="portal-entry-meta">{{portal.count}} 题 · 最高 {{portal.best}} 分</text>
    </view>
    <text class="portal-entry-arrow">→</text>
  </view>

  <text class="note">更多模块筹备中，敬请期待</text>
</view>

<!-- 黑话挑战模块主页 -->
<view wx:elif="{{view === 'quiz'}}" class="container">
  <view class="page-head">
    <text class="back-btn" bindtap="goPortal">← 模块</text>
  </view>
  <view class="hero">
    <view class="brand-logo">申</view>
    <text class="hero-title">把大白话，翻译成体制内的表达</text>
    <text class="hero-sub">看到材料别慌。给你一段场景，选出它的规范表达——答得越多，写得越像。</text>
  </view>

  <view class="stats">
    <view wx:for="{{statsCards}}" wx:key="label" class="stat-card">
      <text class="stat-num">{{item.num}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <text class="section-label">选择模式</text>
  <view
    wx:for="{{modeCards}}"
    wx:key="mode"
    class="mode-card"
    hover-class="mode-card-pressed"
    hover-stay-time="80"
    data-mode="{{item.mode}}"
    bindtap="onModeTap"
  >
    <text class="mode-num">{{item.num}}</text>
    <text class="mode-title">{{item.title}}</text>
    <text class="mode-desc">{{item.desc}}</text>
    <text class="mode-arrow">→</text>
  </view>

  <text class="note">题库来源：《申论规范表达8页》整理版 · 进度与错题保存在本机</text>
</view>

<!-- 分类专练 -->
<view wx:elif="{{view === 'categories'}}" class="container">
  <view class="page-head">
    <text class="back-btn" bindtap="goHome">← 返回</text>
    <text class="badge">分类专练</text>
  </view>
  <text class="section-label">选择一个主题</text>
  <view
    wx:for="{{catList}}"
    wx:key="c"
    class="mode-card"
    hover-class="mode-card-pressed"
    hover-stay-time="80"
    data-cat="{{item.c}}"
    bindtap="onCatTap"
  >
    <view class="cat-row">
      <text class="mode-title">{{item.c}}</text>
      <text class="cat-count">{{item.count}} 题 →</text>
    </view>
  </view>
</view>

<!-- 游戏页 -->
<view wx:elif="{{view === 'game'}}" class="container">
  <view class="page-head">
    <text class="back-btn" bindtap="goHome">← 退出</text>
    <text class="badge">{{game.modeLabel}}{{game.categorySuffix}}</text>
    <text class="sound-btn" bindtap="onToggleSound">{{soundOn ? '🔊' : '🔇'}}</text>
    <view class="metrics">
      <view class="metric">
        <text class="metric-num">{{g.score}}</text>
        <text class="metric-label">分</text>
      </view>
      <view class="metric">
        <text class="metric-num">{{game.progressText}}</text>
        <text class="metric-label {{game.timerLow ? 'metric-timer-low' : 'metric-timer'}}">{{game.timerLabel}}</text>
      </view>
    </view>
  </view>

  <view class="progress-track">
    <view class="progress-bar {{game.barLow ? 'progress-low' : ''}}" style="width: {{game.barPercent}}%;" />
  </view>

  <text wx:if="{{g.combo >= 2}}" class="combo">连击 × {{g.combo}} {{game.stars}}</text>
  <view wx:else class="combo" />

  <view wx:if="{{g.current}}" class="qcard">
    <text class="qtag">{{g.current.c}}</text>
    <text class="qtext">{{g.current.q}}</text>
    <text class="qhint">上面这种情况，对应的规范表达是？</text>

    <view class="opts">
      <view
        wx:for="{{game.opts}}"
        wx:key="text"
        class="opt {{item.cls}}"
        hover-class="{{game.locked ? 'none' : 'opt-pressed'}}"
        hover-stay-time="80"
        data-index="{{index}}"
        bindtap="onOptionTap"
      >
        <text class="opt-key {{item.keyCls}}">{{index + 1}}</text>
        <text class="opt-text">{{item.text}}</text>
      </view>
    </view>

    <view wx:if="{{g.locked}}" class="explain {{game.explainCls}}">
      <text class="explain-title">{{game.explainTitle}}</text>
      <text wx:if="{{!game.explainOk}}" class="explain-answer">{{g.current.a}}</text>
      <view class="next-btn" hover-class="next-btn-pressed" bindtap="onNextTap">
        <text>{{game.nextLabel}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 结果页 -->
<view wx:else class="container">
  <view class="result">
    <text class="result-label">本局得分</text>
    <text class="score">{{g.score}}</text>
    <view class="rank-wrap">
      <text class="rank">{{result.rank}}</text>
    </view>
    <view class="rgrid">
      <view wx:for="{{result.cards}}" wx:key="label" class="stat-card">
        <text class="stat-num">{{item.num}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{mistakes.length > 0}}" class="review">
      <text class="review-title">本局错题回顾</text>
      <view wx:for="{{mistakes}}" wx:key="id" class="ritem">
        <text class="rq">{{item.q}}</text>
        <text class="ra">→ {{item.a}}</text>
      </view>
    </view>

    <view class="primary-btn" hover-class="next-btn-pressed" bindtap="onReplay">
      <text>再来一局</text>
    </view>
    <view class="ghost-btn" hover-class="next-btn-pressed" bindtap="goHome">
      <text>返回主菜单</text>
    </view>
  </view>
</view>
